{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/shelf-market run build",
  "outputDirectory": "artifacts/shelf-market/dist/public",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
